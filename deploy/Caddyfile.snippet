ring.ddctl.com {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	# 本站不记录包含访客 IP 的访问日志；应用本身也不持久化 IP。
	log {
		output discard
	}

	reverse_proxy pet-ring:8080
}

